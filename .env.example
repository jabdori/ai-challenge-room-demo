# Server-only secrets for the Sites Worker. Do not put real values in this file.
# Do not store the plaintext access code in an environment variable. Set only a
# `token-sha256$digest` hash produced by passing a random 32- to 128-character
# URL-safe token to `createHighEntropyAccessCodeHash`.
DEMO_ACCESS_CODE_HASH=

# Secret used to sign the Judge session cookie. It must be 32–1024 UTF-8 bytes.
DEMO_SESSION_SECRET=

# Used for OpenAI calls by Candidates A/B/C, the auxiliary Judge, and the
# Decision Memo. Set only a disposable project key on the server and revoke it
# after the demo.
OPENAI_API_KEY=

# Session, authentication, and execution limits for the Sites Worker. All values
# must be positive integer strings.
# Session lifetime in seconds (maximum 86400)
DEMO_SESSION_TTL_SECONDS=
# Allowed authentication failures (maximum 100)
DEMO_AUTH_FAILURE_LIMIT=
# Authentication-failure aggregation window in milliseconds (maximum 86400000)
DEMO_AUTH_FAILURE_WINDOW_MS=
# Authentication-failure block duration in milliseconds (maximum 86400000)
DEMO_AUTH_FAILURE_BLOCK_MS=
# Live-execution ownership lease in milliseconds (maximum 3600000)
DEMO_LEASE_DURATION_MS=

# Cost values use micro-USD. 1 USD = 1,000,000 micro-USD.
# Maximum cost reserved when starting one live comparison
DEMO_RESERVED_COST_MICRO_USD=
# Successful live-comparison limit per session (maximum 100)
DEMO_MAX_SUCCESSFUL_RUNS_PER_SESSION=
# Operational retry limit per session (maximum 100)
DEMO_MAX_OPERATIONAL_RETRIES_PER_SESSION=
# Global concurrent live-comparison limit (maximum 100)
DEMO_MAX_GLOBAL_CONCURRENT_RUNS=
# Live-comparison limit per authoritative cost aggregation bucket (maximum
# 10000, at least the global concurrent live-comparison limit)
DEMO_MAX_BUCKET_RUN_COUNT=
# Reserved and actual cost limit per authoritative cost aggregation bucket
# (micro-USD, maximum 1000000000, at least the reserved cost for one live
# comparison)
DEMO_MAX_BUCKET_COST_MICRO_USD=
# GPT-5.6 auxiliary Judge and Decision Memo call-attempt limit per aggregation
# bucket (maximum 100000)
DEMO_MAX_AUXILIARY_CALLS_PER_BUCKET=

# Cloudflare/Sites bindings are not dotenv values.
# Bind ASSETS, DB (D1), and ARTIFACTS (R2) in the deployment configuration.

# Optional settings for the existing Node loopback development server.
# Do not confuse them with Sites Worker settings.
AI_HACKATHON_DEMO_PORT=4173
# AI_HACKATHON_DEMO_CANARY_PACK=/absolute/path/to/calibration-pack.json
# AI_HACKATHON_DEMO_STATIC_DIRECTORY=/absolute/path/to/app/dist

# Optional output path for the live A/B/C calibration CLI.
# For each execution, use a new direct child path under the canonical 0700
# `.runtime` directory.
# AI_CALIBRATION_OUTPUT_DIR=/absolute/path/to/app/.runtime/run-id
