{
  "name": "ai-challenge-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "eval:smoke": "node --import tsx eval/cli/runCalibrationSmoke.ts",
    "eval:calibration:abc": "node --import tsx eval/cli/runThreeCandidateCalibration.ts",
    "eval:define:structure": "node --import tsx eval/cli/runDefineStructure.ts",
    "eval:define:approve": "node --import tsx eval/cli/approveSyntheticChallenge.ts",
    "eval:benchmark": "node --import tsx eval/cli/runRecordedBenchmark.ts",
    "eval:regression": "node --import tsx eval/cli/runRecordedRegression.ts",
    "workspace:serve": "node --import tsx server/serveWorkspace.ts",
    "workspace:serve:authoritative": "node --import tsx server/authoritativeChallengeRoomProcess.ts",
    "demo:serve": "node --env-file-if-exists=../.env --import tsx server/hackathonDemoProcess.ts",
    "db:generate": "drizzle-kit generate --name sites_demo",
    "test": "vitest",
    "test:run": "vitest run src/test && vitest run server/test && vitest run server/sites && vitest run eval/test && vitest run --config vitest.worker.config.ts",
    "test:worker": "vitest --config vitest.worker.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "drizzle-orm": "0.45.2",
    "openai": "6.47.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260718.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "drizzle-kit": "0.31.10",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  }
}
